@*
    A password box with the rules on it. Wraps Shiny's PasswordStrength so the policy has one
    translation point: every place that sets a password reads the same server-sent rules, and a
    change to them cannot leave one screen behind.

    The meter is an affordance, not the gate - the server validates the same rules on every path
    that sets a password, browser or not.
*@

<div class="pwfield">
    @if (this.Label is { Length: > 0 } label)
    {
        <span class="field__label">@label</span>
    }

    <PasswordStrength Password="@this.Password"
                      PasswordChanged="this.OnChanged"
                      Placeholder="@this.Placeholder"
                      MinimumLength="@this.Policy.MinimumLength"
                      RequireUppercase="this.Policy.Enabled && this.Policy.RequireUppercase"
                      RequireLowercase="this.Policy.Enabled && this.Policy.RequireLowercase"
                      RequireNumber="this.Policy.Enabled && this.Policy.RequireNumber"
                      RequireSpecialCharacter="this.Policy.Enabled && this.Policy.RequireSpecialCharacter"
                      BlockedPasswords="this.Blocked"
                      UserInputs="this.UserInputs"
                      ShowMeter="this.Policy.Enabled"
                      ShowRules="this.Policy.Enabled"
                      ShowStrengthLabel="this.Policy.Enabled"
                      ShowVisibilityToggle="true"
                      MeterStyle="PasswordStrengthMeterStyle.Segments"
                      WeakColor="#A3162A"
                      FairColor="#A85B08"
                      GoodColor="#0E6F70"
                      StrongColor="#0E6F70"
                      StrengthChanged="this.OnStrength" />

    @if (this.Hint is { Length: > 0 } hint)
    {
        <span class="admin__hint">@hint</span>
    }
</div>

@code {
    /// <summary>
    /// The same handful the server refuses. Kept short deliberately - this is the "you are about to
    /// be told no" hint, and the server's list is the one that decides.
    /// </summary>
    static readonly string[] CommonPasswords =
    [
        "123456", "123456789", "12345678", "password", "password1", "password123", "qwerty",
        "abc123", "111111", "iloveyou", "admin", "administrator", "welcome", "letmein", "monkey",
        "dragon", "passw0rd", "p@ssw0rd", "changeme", "secret", "root", "test", "guest", "default"
    ];

    [Parameter] public string Password { get; set; } = "";
    [Parameter] public EventCallback<string> PasswordChanged { get; set; }

    /// <summary>Raised with whether the password currently satisfies the rules.</summary>
    [Parameter] public EventCallback<bool> AcceptableChanged { get; set; }

    [Parameter, EditorRequired] public PasswordPolicyInfo Policy { get; set; } = PasswordPolicyInfo.Off;
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Hint { get; set; }
    [Parameter] public string Placeholder { get; set; } = "";

    /// <summary>A username or display name this password must not simply repeat.</summary>
    [Parameter] public IReadOnlyList<string>? UserInputs { get; set; }

    IReadOnlyList<string>? Blocked => this.Policy is { Enabled: true, BlockCommonPasswords: true }
        ? CommonPasswords
        : null;

    Task OnChanged(string value)
    {
        this.Password = value;
        return this.PasswordChanged.InvokeAsync(value);
    }

    Task OnStrength(PasswordStrengthChangedEventArgs args)
    {
        // With the rules off, anything non-empty is acceptable - the meter has nothing to say.
        var acceptable = this.Policy.Enabled ? args.IsAcceptable : this.Password.Length > 0;
        return this.AcceptableChanged.InvokeAsync(acceptable);
    }
}
