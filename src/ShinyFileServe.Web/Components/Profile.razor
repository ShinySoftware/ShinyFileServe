@*
    Your own account, and the one thing you can do to it. A modal rather than a page because it is a
    short errand with an obvious end - unlike Activity or People, which are screens you read.

    It is also the way out of an expired password, so when Forced is set there is no way past it
    except through it.
*@
@inject FileServeApi Api
@inject IToastService Toasts
@inject NavigationManager Nav
@inject IJSRuntime JS

<ModalView IsOpen="this.IsOpen"
           IsOpenChanged="this.SetOpen"
           Title="Your account"
           Subtitle="@(this.Forced ? "Your password has expired" : "Who you are here, and your password")"
           Size="ModalSize.Medium"
           CloseOnBackdropClick="false"
           CloseOnEscape="@(!this.Forced)"
           ShowCloseButton="@(!this.Forced)"
           Opened="this.Load">

    <div class="admin">
        @if (this.profile is not { } me)
        {
            <p class="admin__loading">Looking…</p>
        }
        else
        {
            @if (this.Forced)
            {
                <p class="restore restore__warn" role="alert">
                    This server asks for a new password every @me.Passwords.MaximumAgeDays days.
                    Until you set one, nothing else here will answer.
                </p>
            }

            <div class="profile__facts">
                <div class="profile__fact">
                    <span class="profile__label">Name</span>
                    <span class="profile__value">@me.DisplayName</span>
                </div>
                <div class="profile__fact">
                    <span class="profile__label">Username</span>
                    <span class="profile__value num">@me.Username</span>
                </div>
                <div class="profile__fact">
                    <span class="profile__label">Groups</span>
                    <span class="profile__value">@(me.Roles.Count == 0 ? "None" : String.Join(", ", me.Roles))</span>
                </div>
                <div class="profile__fact">
                    <span class="profile__label">Password set</span>
                    <span class="profile__value">
                        @(me.PasswordSetUtc is { } set ? Format.When(set) : "This account has no password")
                    </span>
                </div>
                @if (me.PasswordExpiresUtc is { } expires)
                {
                    <div class="profile__fact">
                        <span class="profile__label">Expires</span>
                        <span class="profile__value @(me.MustChangePassword ? "profile__value--warn" : "")">
                            @Format.When(expires)
                        </span>
                    </div>
                }
            </div>

            @* Only for the accounts that have one. Most do not, and an empty meter would be an
               answer to a question this modal was not asked. *@
            @if (me.AccountDownload is not null || me.AccountUpload is not null)
            {
                <section class="admin__block">
                    <h3>Your allowance</h3>
                    <span class="admin__hint">
                        What you may move across every share put together. A share can meter you more
                        tightly than this on its own; the bar above the files is that one.
                    </span>

                    <div class="meters">
                        @if (me.AccountDownload is { } down)
                        {
                            <QuotaMeter Label="Download" Quota="down" />
                        }
                        @if (me.AccountUpload is { } up)
                        {
                            <QuotaMeter Label="Upload" Quota="up" />
                        }
                    </div>
                </section>
            }

            @if (me.Packages is { } packages && (packages.NuGetEnabled || packages.NpmEnabled) && !this.Forced)
            {
                <section class="admin__block">
                    <h3>Packages</h3>

                    <div class="profile__facts">
                        @if (packages.NuGetEnabled)
                        {
                            <div class="profile__fact">
                                <span class="profile__label">NuGet</span>
                                <span class="profile__value">@Rights(packages, PackagePermissionsExtensions.NuGetFlags)</span>
                            </div>
                        }
                        @if (packages.NpmEnabled)
                        {
                            <div class="profile__fact">
                                <span class="profile__label">npm</span>
                                <span class="profile__value">@Rights(packages, PackagePermissionsExtensions.NpmFlags)</span>
                            </div>
                        }
                    </div>

                    @if (!packages.CanCreateTokens)
                    {
                        <span class="admin__hint">
                            You signed in without a password, so this account cannot hold access tokens.
                        </span>
                    }
                    else
                    {
                        @if (this.created is { } fresh)
                        {
                            <p class="restore__body">
                                Your new token. Copy it now - it will not be shown again.
                            </p>
                            <div class="secret">
                                <code>@fresh.Secret</code>
                                <button type="button" class="action" @onclick="() => this.Copy(fresh.Secret)">Copy</button>
                            </div>
                        }

                        @if (packages.NuGetEnabled)
                        {
                            <span class="field__label">NuGet - add the source, then push</span>
                            <pre class="snippet">@this.NuGetSnippet(me.Username)</pre>
                        }
                        @if (packages.NpmEnabled)
                        {
                            <span class="field__label">npm - in your project's .npmrc</span>
                            <pre class="snippet">@this.NpmSnippet()</pre>
                        }

                        <span class="field__label">Your access tokens</span>
                        @if (this.tokens.Count == 0)
                        {
                            <span class="admin__hint">None yet.</span>
                        }
                        else
                        {
                            <ul class="rows">
                                @foreach (var token in this.tokens)
                                {
                                    <li class="row">
                                        <div class="row__main">
                                            <span class="row__title">@token.Name <span class="row__id num">…@token.Hint</span></span>
                                            <span class="row__sub">
                                                Made @Format.When(token.CreatedUtc)
                                                · @(token.LastUsedUtc is { } used ? $"last used {Format.When(used)}" : "never used")
                                                @if (token.ExpiresUtc is { } tokenExpires)
                                                {
                                                    <span> · expires @Format.When(tokenExpires)</span>
                                                }
                                            </span>
                                        </div>
                                        <span class="row__actions">
                                            <button type="button" class="action action--danger" disabled="@this.busy"
                                                    @onclick="() => this.Revoke(token)">Revoke</button>
                                        </span>
                                    </li>
                                }
                            </ul>
                        }

                        <div class="people__add">
                            <input placeholder="Token name, e.g. build server" maxlength="100"
                                   @bind="this.tokenName" @bind:event="oninput" />
                            <select @bind="this.tokenDays">
                                <option value="30">30 days</option>
                                <option value="90">90 days</option>
                                <option value="365">1 year</option>
                                <option value="0">Never expires</option>
                            </select>
                            <button type="button" class="action"
                                    disabled="@(this.busy || String.IsNullOrWhiteSpace(this.tokenName))"
                                    @onclick="this.CreateToken">Create token</button>
                        </div>
                    }
                </section>
            }

            @if (!me.CanChangePassword)
            {
                <p class="admin__hint">
                    You signed in without a password, so there is none to change.
                </p>
            }
            else
            {
                <section class="admin__block">
                    <h3>Change your password</h3>

                    @if (this.error is { Length: > 0 } error)
                    {
                        <p class="form-error" role="alert">@error</p>
                    }

                    <label class="field">
                        <span class="field__label">Your current password</span>
                        <input type="password" autocomplete="current-password"
                               @bind="this.currentPassword" @bind:event="oninput" />
                    </label>

                    <PasswordField Label="New password"
                                   Password="@this.newPassword"
                                   PasswordChanged="this.OnNewPassword"
                                   Policy="me.Passwords"
                                   UserInputs="@(new[] { me.Username, me.DisplayName })"
                                   AcceptableChanged="v => this.acceptable = v" />

                    <div class="admin__actions">
                        <button type="button" class="action action--primary"
                                disabled="@(this.busy || !this.CanSave)"
                                @onclick="this.Save">
                            Set new password
                        </button>

                        @* No way out while the password has expired: closing this would leave the
                           person with a session that answers nothing. *@
                        @if (!this.Forced)
                        {
                            <button type="button" class="action" @onclick="() => this.SetOpen(false)">Close</button>
                        }
                    </div>
                </section>
            }
        }
    </div>
</ModalView>

@code {
    AccountProfile? profile;
    List<AccessTokenInfo> tokens = [];
    CreatedAccessToken? created;
    string tokenName = "";
    int tokenDays = 90;
    string currentPassword = "";
    string newPassword = "";
    bool acceptable;
    bool busy;
    string? error;

    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    /// <summary>The password has expired: this is the only screen that answers until it changes.</summary>
    [Parameter] public bool Forced { get; set; }

    bool CanSave => this.currentPassword.Length > 0 && this.newPassword.Length > 0 && this.acceptable;

    /// <summary>
    /// Passes the modal's own close back up to whoever opened it. Binding the inner ModalView
    /// straight to this component's IsOpen would write the parameter and stop there, leaving the
    /// parent still believing the modal is open - so the next click would change nothing.
    /// </summary>
    async Task SetOpen(bool value)
    {
        // Forced means forced. The close button is not rendered, but a backdrop click or an Escape
        // would otherwise still get past a rule the server is going to enforce anyway.
        if (this.Forced && !value)
            return;

        if (this.IsOpen == value)
            return;

        this.IsOpen = value;
        await this.IsOpenChanged.InvokeAsync(value);
    }

    async Task Load()
    {
        this.error = null;
        this.currentPassword = "";
        this.newPassword = "";
        this.acceptable = false;

        this.created = null;
        this.tokenName = "";

        try
        {
            this.profile = await this.Api.GetProfile();

            if (this.profile.Packages is { CanCreateTokens: true } packages && (packages.NuGetEnabled || packages.NpmEnabled))
                this.tokens = await this.Api.GetTokens();
        }
        catch (ApiException ex)
        {
            this.error = ex.Message;
        }
    }

    void OnNewPassword(string value) => this.newPassword = value ?? "";

    // -- packages -----------------------------------------------------------

    static string Rights(PackageAccessInfo packages, IReadOnlyList<PackagePermissions> flags)
    {
        var mine = flags.Where(f => packages.Permissions.Has(f)).Select(f => f.ToDisplay()).ToList();
        var anyone = flags.Where(f => packages.Anonymous.Has(f) && !packages.Permissions.Has(f)).Select(f => f.ToDisplay()).ToList();

        if (mine.Count == 0 && anyone.Count == 0)
            return "No access";

        var text = mine.Count == 0 ? "" : String.Join(", ", mine);
        if (anyone.Count > 0)
            text += (text.Length > 0 ? " · " : "") + String.Join(", ", anyone) + " (open to anyone)";

        return text;
    }

    /// <summary>The address this browser reached the server by - the one most likely to work from here.</summary>
    string FeedUrl(string path) => this.Nav.BaseUri.TrimEnd('/') + "/" + path;

    string Secret => this.created?.Secret ?? "<token>";

    /// <summary>
    /// Source credentials as well as the push key: NuGet reads the service index before it sends the
    /// key, so a feed that needs a token to read has to have one for the source too.
    /// </summary>
    string NuGetSnippet(string username)
    {
        var url = this.FeedUrl(PackageAccessInfo.NuGetPath);

        // NuGet refuses plain-http sources unless told otherwise, and a server on the LAN is plain http.
        var insecure = url.StartsWith("http:", StringComparison.OrdinalIgnoreCase) ? " --allow-insecure-connections" : "";

        return $"dotnet nuget add source {url} -n fileserve \\\n" +
            $"  -u {username} -p {this.Secret} --store-password-in-clear-text{insecure}\n" +
            $"dotnet nuget push My.Package.1.0.0.nupkg -s fileserve -k {this.Secret}";
    }

    string NpmSnippet()
    {
        var url = this.FeedUrl(PackageAccessInfo.NpmPath);

        // .npmrc keys the token by the registry URL with its scheme dropped.
        var key = url[(url.IndexOf("://", StringComparison.Ordinal) + 1)..];
        return $"registry={url}\n{key}:_authToken={this.Secret}";
    }

    async Task Copy(string text)
    {
        try
        {
            await this.JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            await this.Toasts.SuccessAsync("Copied.");
        }
        catch (JSException)
        {
            // An insecure context (plain http on a LAN address) has no clipboard API. The token
            // is on screen to select by hand.
            await this.Toasts.WarningAsync("This browser would not copy it here. Select the token and copy it by hand.");
        }
    }

    async Task CreateToken()
    {
        this.busy = true;
        try
        {
            this.created = await this.Api.CreateToken(this.tokenName.Trim(), this.tokenDays == 0 ? null : this.tokenDays);
            this.tokenName = "";
            this.tokens = await this.Api.GetTokens();
        }
        catch (ApiException ex)
        {
            await this.Toasts.DangerAsync(ex.Message);
        }
        finally
        {
            this.busy = false;
        }
    }

    async Task Revoke(AccessTokenInfo token)
    {
        this.busy = true;
        try
        {
            await this.Api.RevokeToken(token.Id);
            this.tokens = await this.Api.GetTokens();

            if (this.created?.Token.Id == token.Id)
                this.created = null;

            await this.Toasts.SuccessAsync($"Revoked {token.Name}. Anything still using it is refused from now on.");
        }
        catch (ApiException ex)
        {
            await this.Toasts.DangerAsync(ex.Message);
        }
        finally
        {
            this.busy = false;
        }
    }

    async Task Save()
    {
        this.busy = true;
        this.error = null;

        try
        {
            await this.Api.ChangePassword(this.currentPassword, this.newPassword);
            await this.Toasts.SuccessAsync("Your password has been changed.");

            // Re-read rather than assume: the server is what decides whether the session is still
            // in the must-change state, and it has just stopped being so.
            await this.Load();

            // Forced blocks SetOpen, so the flag goes first - the errand is done either way.
            this.Forced = false;
            await this.SetOpen(false);
        }
        catch (ApiException ex)
        {
            this.error = ex.Message;
        }
        finally
        {
            this.busy = false;
        }
    }
}
