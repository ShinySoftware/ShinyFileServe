@*
    Server administration from the browser. Same surface the desktop app drives, so the two can
    never show different answers. Only rendered for an administrator - and the endpoints behind it
    are role-gated regardless, so hiding this is a courtesy, not the security boundary.
*@
@inject FileServeApi Api
@inject AdminApi Admin
@inject NavigationManager Nav
@inject IToastService Toasts

@if (this.status is null)
{
    <p class="admin__loading">Reading the server…</p>
}
else
{
    <div class="admin">

        <section class="admin__block">
            <div class="admin__head">
                <span class="admin__dot @(this.status.IsServing ? "is-on" : "")"></span>
                <div>
                    <h3>@(this.status.IsServing ? "Serving" : "Stopped")</h3>
                    <p class="admin__sub">
                        @(this.status.ActiveConnections == 1
                            ? "1 open connection"
                            : $"{this.status.ActiveConnections} open connections")
                    </p>
                </div>
                <button type="button" class="action" disabled="@this.busy" @onclick="this.ToggleServer">
                    @(this.status.IsServing ? "Stop" : "Start")
                </button>
            </div>

            @if (this.status.LocalUrls.Count > 0)
            {
                <ul class="admin__urls">
                    @foreach (var url in this.status.LocalUrls)
                    {
                        <li class="num">@url</li>
                    }
                </ul>
            }
        </section>

        <section class="admin__block">
            <div class="admin__head">
                <span class="admin__dot @(this.status.Tunnel == TunnelStatus.Open ? "is-on" : "")"></span>
                <div>
                    <h3>@this.TunnelText</h3>
                    <p class="admin__sub">A public address that reaches this machine from anywhere.</p>
                </div>
                <button type="button" class="action" disabled="@(this.busy || !this.status.IsServing)"
                        @onclick="this.ToggleTunnel">
                    @(this.status.Tunnel is TunnelStatus.Open or TunnelStatus.Connecting ? "Close" : "Open")
                </button>
            </div>

            @if (this.status.TunnelUrl is { Length: > 0 } tunnelUrl)
            {
                <ul class="admin__urls"><li class="num">@tunnelUrl</li></ul>
            }
            @if (this.status.Tunnel == TunnelStatus.Failed && this.status.TunnelError is { Length: > 0 } tunnelError)
            {
                <p class="form-error">@tunnelError</p>
            }
        </section>

        <section class="admin__block">
            <h3>Configuration</h3>

            <label class="field">
                <span class="field__label">Port</span>
                <input type="number" min="1" max="65535" @bind="this.port" />
                <span class="admin__hint">The server always listens on every network interface on this machine.</span>
            </label>

            <label class="field">
                <span class="field__label">Pinggy access token</span>
                <input type="password" placeholder="@this.TokenPlaceholder" @bind="this.token" @bind:event="oninput" />
                <span class="admin__hint">@this.TokenHint</span>
            </label>

            <label class="field--check">
                <input type="checkbox" @bind="this.autoStartServer" />
                Start serving when the app opens
            </label>

            <label class="field--check">
                <input type="checkbox" @bind="this.autoStartTunnel" />
                Open the tunnel whenever the server starts
            </label>

        </section>

        <section class="admin__block">
            <h3>Sessions</h3>

            <label class="field--check">
                <input type="checkbox" @bind="this.allowRememberMe" />
                Offer "keep me signed in" on the sign-in page
            </label>

            @if (this.allowRememberMe)
            {
                <label class="field">
                    <span class="field__label">A remembered session lasts</span>
                    <input type="number" min="1" max="3650" @bind="this.rememberMeDays" />
                    <span class="admin__hint">Days. Without this, every session ends when the browser closes.</span>
                </label>
            }

            <label class="field">
                <span class="field__label">Sign out after</span>
                <input type="number" min="0" max="1440" @bind="this.idleLogoffMinutes" />
                <span class="admin__hint">
                    Minutes with no keyboard or mouse. 0 never signs anyone out for being idle.
                </span>
            </label>
        </section>

        <section class="admin__block">
            <h3>Backup</h3>
            <span class="admin__hint">
                One file holds everything: accounts, groups, shares, quota counters, settings and
                the activity log. It does not contain the files themselves — those stay where they are.
            </span>

            <div class="admin__actions">
                <a class="action" href="@this.Admin.BackupUrl" download>Download a backup</a>

                <label class="action">
                    Choose a backup to restore…
                    <InputFile OnChange="this.OnBackupPicked" accept=".db" style="display:none" />
                </label>
            </div>

            @if (this.staged is { } staged)
            {
                @if (staged.IsValid)
                {
                    <div class="restore">
                        <p class="restore__title">Ready to restore</p>
                        <p class="restore__body">
                            @staged.Users @(staged.Users == 1 ? "account" : "accounts")
                            (@staged.Administrators @(staged.Administrators == 1 ? "administrator" : "administrators")),
                            @staged.Shares @(staged.Shares == 1 ? "share" : "shares"),
                            @staged.ActivityEntries log @(staged.ActivityEntries == 1 ? "entry" : "entries")
                            · @Format.Bytes(staged.SizeBytes)
                            @if (staged.TakenUtc is { } taken)
                            {
                                <span> · settings last changed @Format.When(taken)</span>
                            }
                        </p>
                        <p class="restore__warn">
                            This replaces every account, share and log entry on this server. If your
                            own account is not in that backup, you will be signed out.
                        </p>
                        <div class="admin__actions">
                            <button type="button" class="action action--danger" disabled="@this.busy"
                                    @onclick="this.Restore">Restore and restart</button>
                            <button type="button" class="action" disabled="@this.busy"
                                    @onclick="this.DiscardBackup">Cancel</button>
                        </div>
                    </div>
                }
                else
                {
                    <p class="form-error" role="alert">@staged.Problem</p>
                }
            }
        </section>

        <section class="admin__block">
            <h3>Passwords</h3>

            <label class="field--check">
                <input type="checkbox" @bind="this.passwordsEnabled" />
                Apply password rules
            </label>

            @if (this.passwordsEnabled)
            {
                <label class="field">
                    <span class="field__label">Minimum length</span>
                    <input type="number" min="1" max="128" @bind="this.passwordMinimum" />
                </label>

                <div class="admin__checks">
                    <label class="field--check">
                        <input type="checkbox" @bind="this.requireUpper" /> A capital letter
                    </label>
                    <label class="field--check">
                        <input type="checkbox" @bind="this.requireLower" /> A lower-case letter
                    </label>
                    <label class="field--check">
                        <input type="checkbox" @bind="this.requireNumber" /> A number
                    </label>
                    <label class="field--check">
                        <input type="checkbox" @bind="this.requireSymbol" /> A symbol
                    </label>
                    <label class="field--check">
                        <input type="checkbox" @bind="this.blockCommon" /> Not a commonly guessed password
                    </label>
                </div>
            }
            else
            {
                <span class="admin__hint">
                    Any password is accepted, as long as it is not blank. Reasonable on a machine
                    only you can reach; think again before opening the tunnel.
                </span>
            }

            <span class="admin__hint">
                Existing passwords are not re-checked. The rules apply the next time one is set.
            </span>

            <label class="field">
                <span class="field__label">Ask for a new password after</span>
                <input type="number" min="0" max="3650" @bind="this.passwordMaxAgeDays" />
                <span class="admin__hint">
                    Days. 0 never expires one. Past that age somebody can still sign in, but nothing
                    answers until they set a new password.
                </span>
            </label>

            @* Outside the rules above on purpose: an account locks itself whether or not this
               server has opinions about what a password looks like. *@
            <label class="field">
                <span class="field__label">Lock an account after</span>
                <input type="number" min="0" max="100" @bind="this.maxFailedSignIns" />
                <span class="admin__hint">
                    Consecutive failed sign-ins. 0 never locks anybody. Only an administrator can
                    unlock one, from the People screen.
                </span>
            </label>
        </section>

        <section class="admin__block">
            <h3>Notifications</h3>

            <label class="field--check">
                <input type="checkbox" @bind="this.notificationsEnabled" />
                Show a desktop notification on the server machine
            </label>

            @if (this.notificationsEnabled)
            {
                <div class="admin__checks">
                    @foreach (var action in ActivityActions.Notifiable)
                    {
                        var selected = this.notifyOn.Contains(action);
                        <label class="field--check">
                            <input type="checkbox" checked="@selected"
                                   @onchange="e => this.ToggleNotify(action, (bool?)e.Value == true)" />
                            @action.ToDisplay()
                        </label>
                    }
                </div>
            }

            <span class="admin__hint">
                Notifications land on the machine running the server, not here. Everything is written
                to the activity log either way.
            </span>

            <div class="admin__actions">
                <button type="button" class="action action--primary" disabled="@this.busy" @onclick="this.Save">
                    Save settings
                </button>
                @if (this.status.Config.HasPinggyToken)
                {
                    <button type="button" class="action" disabled="@this.busy" @onclick="this.ClearToken">
                        Clear token
                    </button>
                }
            </div>
        </section>
    </div>
}

@code {
    ServerStatus? status;
    int port = 8080;
    string token = "";
    bool autoStartServer;
    bool autoStartTunnel;
    BackupSummary? staged;
    bool passwordsEnabled = true;
    int passwordMinimum = 8;
    bool requireUpper;
    bool requireLower;
    bool requireNumber;
    bool requireSymbol;
    bool blockCommon = true;
    int passwordMaxAgeDays;
    int maxFailedSignIns = 10;
    bool allowRememberMe = true;
    int rememberMeDays = 30;
    int idleLogoffMinutes;
    bool notificationsEnabled;
    HashSet<ActivityAction> notifyOn = [];
    bool busy;

    protected override Task OnInitializedAsync() => this.Refresh();

    string TunnelText => this.status?.Tunnel switch
    {
        TunnelStatus.Open => "Open to the internet",
        TunnelStatus.Connecting => "Opening…",
        TunnelStatus.Reconnecting => "Reconnecting…",
        TunnelStatus.Failed => "Tunnel failed",
        _ => "Tunnel closed"
    };

    string TokenPlaceholder => this.status?.Config.HasPinggyToken == true
        ? "A token is stored"
        : "None stored";

    string TokenHint => this.status?.Config.HasPinggyToken == true
        ? "Type a new token to replace the stored one, or leave it blank to keep it."
        : "Without a token, pinggy gives you an anonymous tunnel: it expires after an hour and takes a new address each time it reconnects.";

    async Task Refresh()
    {
        try
        {
            this.status = await this.Api.GetServerStatus();
            this.port = this.status.Config.Port;
            this.autoStartServer = this.status.Config.AutoStartServer;
            this.autoStartTunnel = this.status.Config.AutoStartTunnel;
            var rules = this.status.Config.Passwords;
            this.passwordsEnabled = rules.Enabled;
            this.passwordMinimum = rules.MinimumLength;
            this.requireUpper = rules.RequireUppercase;
            this.requireLower = rules.RequireLowercase;
            this.requireNumber = rules.RequireNumber;
            this.requireSymbol = rules.RequireSpecialCharacter;
            this.blockCommon = rules.BlockCommonPasswords;
            this.passwordMaxAgeDays = rules.MaximumAgeDays;
            this.maxFailedSignIns = this.status.Config.MaxFailedSignIns;

            this.allowRememberMe = this.status.Config.AllowRememberMe;
            this.rememberMeDays = this.status.Config.RememberMeDays;
            this.idleLogoffMinutes = this.status.Config.IdleLogoffMinutes;
            this.notificationsEnabled = this.status.Config.NotificationsEnabled;
            this.notifyOn = [.. this.status.Config.NotifyOn];
            this.token = "";
        }
        catch (ApiException ex)
        {
            await this.Toasts.DangerAsync(ex.Message);
        }
    }

    async Task Run(Func<Task> work)
    {
        this.busy = true;
        try
        {
            await work();
        }
        catch (ApiException ex)
        {
            await this.Toasts.DangerAsync(ex.Message);
        }
        finally
        {
            this.busy = false;
        }
    }

    Task ToggleServer() => this.Run(async () =>
    {
        var starting = this.status?.IsServing != true;
        var next = await this.Api.ControlServer(starting);

        if (next is not null)
        {
            this.status = next;
            return;
        }

        // Stop answers 202 and then closes the socket this page is talking to. Say so plainly
        // rather than leaving a spinner against a server that is no longer there.
        await this.Toasts.WarningAsync("Stopping. This page will lose its connection.");
        this.status = this.status! with { IsServing = false, Tunnel = TunnelStatus.Off, TunnelUrl = null };
    });

    Task ToggleTunnel() => this.Run(async () =>
    {
        var opening = this.status?.Tunnel is not (TunnelStatus.Open or TunnelStatus.Connecting);
        this.status = await this.Api.ControlTunnel(opening);

        if (opening && this.status.Tunnel == TunnelStatus.Open)
            await this.Toasts.SuccessAsync($"Tunnel open at {this.status.TunnelUrl}");
    });

    // -- backup -------------------------------------------------------------

    async Task OnBackupPicked(InputFileChangeEventArgs args)
    {
        if (args.FileCount == 0)
            return;

        var file = args.File;
        this.staged = null;

        await this.Run(async () =>
        {
            // A database of any size worth restoring still fits in a stream; the cap is a guard
            // against somebody picking a disk image by mistake.
            await using var content = file.OpenReadStream(512L * 1024 * 1024);
            this.staged = await this.Admin.StageBackup(file.Name, content, file.Size);

            if (this.staged is { IsValid: false, Problem: { Length: > 0 } problem })
                await this.Toasts.WarningAsync(problem);
        });
    }

    Task DiscardBackup() => this.Run(async () =>
    {
        await this.Admin.DiscardStaged();
        this.staged = null;
    });

    Task Restore() => this.Run(async () =>
    {
        await this.Admin.RestoreStaged();
        this.staged = null;

        // The listener goes away to do the swap, so nothing this page asks for next would arrive.
        // Say so, then reload once the server is back rather than leaving a dead page up.
        await this.Toasts.WarningAsync("Restoring. This page will reload when the server is back.");
        await this.WaitForServerThenReload();
    });

    async Task WaitForServerThenReload()
    {
        for (var attempt = 0; attempt < 40; attempt++)
        {
            await Task.Delay(500);

            try
            {
                await this.Api.GetSessionPolicy();
                this.Nav.NavigateTo(this.Nav.BaseUri, forceLoad: true);
                return;
            }
            catch (Exception)
            {
                // Still down. The restart is a second or two; keep asking.
            }
        }

        await this.Toasts.DangerAsync("The server has not come back. Check the FileServe window on that machine.");
    }

    void ToggleNotify(ActivityAction action, bool selected)
    {
        if (selected)
            this.notifyOn.Add(action);
        else
            this.notifyOn.Remove(action);
    }

    UpdateServerConfig Build(string? token) => new(
        this.port,
        this.autoStartServer,
        this.autoStartTunnel,
        token,
        this.notificationsEnabled,
        [.. this.notifyOn],
        this.allowRememberMe,
        this.rememberMeDays,
        this.idleLogoffMinutes,
        new PasswordPolicyInfo(
            this.passwordsEnabled,
            this.passwordMinimum,
            this.requireUpper,
            this.requireLower,
            this.requireNumber,
            this.requireSymbol,
            this.blockCommon,
            this.passwordMaxAgeDays
        ),
        this.maxFailedSignIns
    );

    Task Save() => this.Run(async () =>
    {
        // Null leaves the stored token alone; the box is blank unless the admin typed a new one.
        this.status = await this.Api.SaveServerConfig(this.Build(this.token.Length == 0 ? null : this.token));
        this.token = "";
        await this.Toasts.SuccessAsync("Saved.");
    });

    Task ClearToken() => this.Run(async () =>
    {
        this.status = await this.Api.SaveServerConfig(this.Build(""));
        this.token = "";
        await this.Toasts.SuccessAsync("Token cleared. The tunnel will be anonymous.");
    });
}
