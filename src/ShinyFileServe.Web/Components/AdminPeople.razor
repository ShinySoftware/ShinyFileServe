    async Task SetRolePackage(RoleInfo role, PackagePermissions flag, bool granted)
    {
        // Publishing to a feed you cannot read from is a state nobody means, so the reads follow
        // the writes on and the writes follow the reads off.
        var packages = granted ? role.Packages | flag : role.Packages & ~flag;

        if (granted && flag is PackagePermissions.NuGetPush or PackagePermissions.NuGetDelete)
            packages |= PackagePermissions.NuGetRead;
        else if (granted && flag is PackagePermissions.NpmPublish)
            packages |= PackagePermissions.NpmRead;
        else if (!granted && flag is PackagePermissions.NuGetRead)
            packages &= ~PackagePermissionsExtensions.NuGet;
        else if (!granted && flag is PackagePermissions.NpmRead)
            packages &= ~PackagePermissionsExtensions.Npm;

        try
        {
            await this.Admin.SaveRole(new SaveRoleRequest(role.Id, role.Name, role.Description, role.IsAdmin, packages));
            await this.Reload();
        }
        catch (ApiException ex)
        {
            await this.Toasts.DangerAsync(ex.Message);
        }
    }

