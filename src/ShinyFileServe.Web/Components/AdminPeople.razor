@*
    Accounts and groups. Rights are granted to a group and people are put in groups, so the two
    belong on one screen - a group with nobody in it and a person in no group are both mistakes
    that only show up when you can see both lists at once.
*@
@inject AdminApi Admin
@inject FileServeApi Api
@inject IToastService Toasts
@inject IDialogService Dialogs

    <div class="people">
        <section class="admin__block">
            <div class="people__head">
                <h3>Accounts</h3>
                <button type="button" class="action action--primary" @onclick="() => this.Edit(null)">Add someone</button>
            </div>

            @if (this.users.Count == 0)
            {
                <p class="admin__loading">Nobody yet.</p>
            }
            else
            {
                <ul class="rows">
                    @foreach (var user in this.users)
                    {
                        <li class="row">
                            <div class="row__main">
                                <span class="row__title">
                                    @user.DisplayName
                                    <span class="row__id num">@user.Username</span>
                                </span>
                                <span class="row__sub">
                                    @(user.RoleNames.Count == 0 ? "No groups" : String.Join(", ", user.RoleNames))
                                    @if (user.IsAnonymous)
                                    {
                                        <span> · no password</span>
                                    }
                                    @if (user.LastLoginUtc is { } last)
                                    {
                                        <span> · last in @Format.When(last)</span>
                                    }
                                </span>

                                @if (CapText(user) is { Length: > 0 } caps)
                                {
                                    <span class="row__sub">@caps</span>
                                }

                                @if (!user.IsAnonymous)
                                {
                                    <span class="row__sub">
                                        @PackageText(user)
                                        @if (user.TokenCount > 0)
                                        {
                                            <span> · @(user.TokenCount == 1 ? "1 access token" : $"{user.TokenCount} access tokens")</span>
                                        }
                                    </span>
                                }

                                @* Said with the count, because a run of ten is a person who forgot
                                   their password and a run of a hundred is somebody else. *@
                                @if (user.LockedOutUtc is { } locked)
                                {
                                    <span class="row__sub row__sub--warn">
                                        Locked @Format.When(locked) after @user.FailedSignInCount failed sign-ins
                                    </span>
                                }
                            </div>

                            <span class="tag @TagClass(user)">@Status(user)</span>

                            <span class="row__actions">
                                @if (user.IsLockedOut)
                                {
                                    <button type="button" class="action action--primary" @onclick="() => this.Unlock(user)">Unlock</button>
                                }
                                <button type="button" class="action" @onclick="() => this.Edit(user)">Edit</button>
                                @if (!user.IsProtected)
                                {
                                    <button type="button" class="action action--danger" @onclick="() => this.Delete(user)">Delete</button>
                                }
                            </span>
                        </li>
                    }
                </ul>
            }
        </section>

        <section class="admin__block">
            <div class="people__head">
                <h3>Groups</h3>
                <div class="people__add">
                    <input placeholder="New group name" @bind="this.newGroup" @bind:event="oninput" />
                    <button type="button" class="action" disabled="@String.IsNullOrWhiteSpace(this.newGroup)"
                            @onclick="this.AddGroup">Add group</button>
                </div>
            </div>

            <ul class="rows">
                @foreach (var role in this.roles)
                {
                    <li class="row">
                        <div class="row__main">
                            <span class="row__title">@role.Name</span>
                            <span class="row__sub">
                                @(role.MemberCount == 1 ? "1 member" : $"{role.MemberCount} members")
                                @if (role.Description is { Length: > 0 } description)
                                {
                                    <span> · @description</span>
                                }
                            </span>

                            @* Package rights sit with the group, like share grants, so a team is
                               given the feed once. One person can still be overridden per feed from
                               their account. *@
                            <div class="row__perms">
                                @if (role.IsAdmin)
                                {
                                    <span class="row__perms-note">Every package right, as administrators</span>
                                }
                                else
                                {
                                    <span class="row__perms-label">NuGet</span>
                                    @foreach (var flag in PackagePermissionsExtensions.NuGetFlags)
                                    {
                                        <label class="row__toggle">
                                            <input type="checkbox" checked="@role.Packages.Has(flag)"
                                                   @onchange="e => this.SetRolePackage(role, flag, (bool?)e.Value == true)" />
                                            @flag.ToDisplay()
                                        </label>
                                    }

                                    <span class="row__perms-label">npm</span>
                                    @foreach (var flag in PackagePermissionsExtensions.NpmFlags)
                                    {
                                        <label class="row__toggle">
                                            <input type="checkbox" checked="@role.Packages.Has(flag)"
                                                   @onchange="e => this.SetRolePackage(role, flag, (bool?)e.Value == true)" />
                                            @flag.ToDisplay()
                                        </label>
                                    }
                                }
                            </div>
                        </div>

                        <label class="row__toggle" title="Administrators reach every share, the log and the settings">
                            <input type="checkbox" checked="@role.IsAdmin" disabled="@role.IsProtected"
                                   @onchange="e => this.SetRoleAdmin(role, (bool?)e.Value == true)" />
                            Administrator
                        </label>

                        <span class="row__actions">
                            @if (!role.IsProtected)
                            {
                                <button type="button" class="action action--danger" @onclick="() => this.DeleteRole(role)">Delete</button>
                            }
                            else
                            {
                                <span class="tag tag--locked">Built in</span>
                            }
                        </span>
                    </li>
                }
            </ul>
        </section>
    </div>

@* The account editor. A second modal rather than an inline form, because the list is the thing
   you come back to and losing your place in it to edit one row is worse than a second layer. *@
<ModalView @bind-IsOpen="this.editorOpen"
           Title="@(this.draft?.Id is null ? "New account" : this.draft?.DisplayName ?? "Account")"
           Size="ModalSize.Medium"
           CloseOnBackdropClick="false">

    @if (this.draft is { } draft)
    {
        <div class="admin">
            @if (this.editorError is { Length: > 0 } editorError)
            {
                <p class="form-error" role="alert">@editorError</p>
            }

            @if (draft.IsProtected)
            {
                <p class="form-note">
                    This is the account this server was set up with. You can rename it and change its
                    password; it stays an administrator and it cannot be deleted.
                </p>
            }

            <label class="field">
                <span class="field__label">Name</span>
                <input @bind="draft.DisplayName" />
            </label>

            <label class="field">
                <span class="field__label">Username</span>
                <input @bind="draft.Username" />
            </label>

            <label class="field">
                <span class="field__label">Email</span>
                <input type="email" @bind="draft.Email" placeholder="Optional" />
            </label>

            @if (!draft.IsAnonymous)
            {
                <PasswordField Label="@(draft.Id is null ? "Password" : "New password")"
                               Policy="this.passwords"
                               Password="@draft.Password"
                               PasswordChanged="v => draft.Password = v"
                               AcceptableChanged="v => this.passwordOk = v"
                               UserInputs="@(new[] { draft.Username, draft.DisplayName })"
                               Hint="@(draft.Id is null ? null : "Leave blank to keep the current password.")" />
            }

            <label class="field--check">
                <input type="checkbox" checked="@draft.IsAnonymous" disabled="@draft.IsProtected"
                       @onchange="e => this.SetAnonymous(draft, (bool?)e.Value == true)" />
                Anyone can sign in as this account
            </label>
            <span class="admin__hint">
                No password at all — the sign-in page offers it as a button to everybody who reaches
                this server. What they can then do is whatever its groups allow, so give it the
                narrowest one. It can never be an administrator.
            </span>

            <div class="admin__block">
                <h3>Groups</h3>
                <div class="admin__checks">
                    @foreach (var role in this.roles)
                    {
                        <label class="field--check">
                            <input type="checkbox" checked="@draft.RoleIds.Contains(role.Id)"
                                   @onchange="e => Toggle(draft.RoleIds, role.Id, (bool?)e.Value == true)" />
                            @role.Name
                        </label>
                    }
                </div>
            </div>

            <label class="field--check">
                <input type="checkbox" @bind="draft.IsAdmin" disabled="@(draft.IsProtected || draft.IsAnonymous)" />
                Administrator
            </label>

            @if (!draft.IsAnonymous)
            {
                <div class="admin__block">
                    <h3>Packages</h3>
                    @if (this.IsAdministrator(draft))
                    {
                        <span class="admin__hint">
                            Administrators can restore, push and unlist on NuGet, and install and publish on
                            npm, whatever is set here.
                        </span>
                    }
                    else
                    {
                        <span class="admin__hint">
                            What this person may do with the NuGet feed and the npm registry. "From groups"
                            leaves it to their groups; anything else replaces what the groups give, for this
                            person only. Write on NuGet is push and unlist; on npm it is publish.
                        </span>

                        <div class="caps">
                            <label class="field">
                                <span class="field__label">NuGet</span>
                                <select @bind="draft.NuGetAccess">
                                    @foreach (var level in PackageAccessLevelExtensions.All)
                                    {
                                        <option value="@level">@this.LevelText(draft, level, PackageFeedKind.NuGet)</option>
                                    }
                                </select>
                            </label>
                            <label class="field">
                                <span class="field__label">npm</span>
                                <select @bind="draft.NpmAccess">
                                    @foreach (var level in PackageAccessLevelExtensions.All)
                                    {
                                        <option value="@level">@this.LevelText(draft, level, PackageFeedKind.Npm)</option>
                                    }
                                </select>
                            </label>
                        </div>
                    }

                    @if (draft.Id is not null)
                    {
                        <span class="field__label">Access tokens</span>
                        @if (this.draftTokens is null)
                        {
                            <span class="admin__hint">Loading…</span>
                        }
                        else if (this.draftTokens.Count == 0)
                        {
                            <span class="admin__hint">None. People make their own from their account.</span>
                        }
                        else
                        {
                            <ul class="rows">
                                @foreach (var item in this.draftTokens)
                                {
                                    <li class="row">
                                        <div class="row__main">
                                            <span class="row__title">@item.Token.Name <span class="row__id num">…@item.Token.Hint</span></span>
                                            <span class="row__sub">
                                                Made @Format.When(item.Token.CreatedUtc)
                                                · @(item.Token.LastUsedUtc is { } used ? $"last used {Format.When(used)}" : "never used")
                                                @if (item.Token.ExpiresUtc is { } expires)
                                                {
                                                    <span> · @(expires <= DateTimeOffset.UtcNow ? "expired" : "expires") @Format.When(expires)</span>
                                                }
                                            </span>
                                        </div>
                                        <span class="row__actions">
                                            <button type="button" class="action action--danger" @onclick="() => this.RevokeToken(item)">Revoke</button>
                                        </span>
                                    </li>
                                }
                            </ul>
                        }
                    }
                </div>
            }

            <div class="admin__block">
                <h3>Expiry</h3>

                @* A date input rather than a text box: a typed date is a date somebody can get
                   wrong, and the account it locks out is not theirs. *@
                <label class="field--check">
                    <input type="checkbox" checked="@(draft.ExpiresOn is null)" disabled="@draft.IsProtected"
                           @onchange="e => this.SetNeverExpires(draft, (bool?)e.Value == true)" />
                    Never expires
                </label>

                @if (draft.ExpiresOn is not null)
                {
                    <label class="field">
                        <span class="field__label">Stops working on</span>
                        <input type="date" @bind="draft.ExpiresOn" @bind:format="yyyy-MM-dd" />
                    </label>
                }

                @if (draft.IsProtected)
                {
                    <span class="admin__hint">
                        This account keeps the server administrable, so it cannot be given a date.
                    </span>
                }
            </div>

            <div class="admin__block">
                <h3>Transfer limits</h3>
                <span class="admin__hint">
                    How many transfers this account may have running at the same time, whatever share
                    they come from. Leave a box empty for no limit. This is about how much of the
                    server one person may occupy at once - what they may move in total is the byte
                    quota on the group's share.
                </span>

                <div class="caps">
                    <label class="field">
                        <span class="field__label">Downloads at once</span>
                        <input type="number" min="1" step="1" placeholder="No limit" @bind="draft.MaxParallelDownloads" />
                    </label>
                    <label class="field">
                        <span class="field__label">Uploads at once</span>
                        <input type="number" min="1" step="1" placeholder="No limit" @bind="draft.MaxParallelUploads" />
                    </label>
                </div>
            </div>

            <div class="admin__block">
                <h3>Account quota</h3>
                <span class="admin__hint">
                    How many bytes this person may move across every share put together. The group's
                    grant already meters each share on its own; this is the ceiling on the account,
                    and a transfer meets whichever of the two runs out first. Leave the window at
                    "No quota" for an account nobody is metering.
                </span>

                <div class="quotas">
                    <div class="quota">
                        <span class="field__label">Download quota</span>
                        <div class="quota__row">
                            <select @bind="draft.DownloadWindow">
                                @foreach (var window in Windows)
                                {
                                    <option value="@window">@WindowText(window)</option>
                                }
                            </select>
                            <input type="number" min="0" step="any" placeholder="MB" aria-label="Download quota in megabytes"
                                   disabled="@(draft.DownloadWindow == QuotaWindow.None)" @bind="draft.DownloadMb" />
                            <span class="quota__unit">MB</span>
                        </div>
                    </div>

                    <div class="quota">
                        <span class="field__label">Upload quota</span>
                        <div class="quota__row">
                            <select @bind="draft.UploadWindow">
                                @foreach (var window in Windows)
                                {
                                    <option value="@window">@WindowText(window)</option>
                                }
                            </select>
                            <input type="number" min="0" step="any" placeholder="MB" aria-label="Upload quota in megabytes"
                                   disabled="@(draft.UploadWindow == QuotaWindow.None)" @bind="draft.UploadMb" />
                            <span class="quota__unit">MB</span>
                        </div>
                    </div>
                </div>

                @if (draft.IsAdmin)
                {
                    <span class="admin__hint">
                        An administrator reaches every share regardless of any grant, but a quota set
                        here still counts against them - it is set on the person, not on a group.
                    </span>
                }
            </div>

            <div class="admin__actions">
                @* An existing account may be saved without touching its password, so an empty box
                   is fine there; a new one has to clear the rules before Save is offered. *@
                <button type="button" class="action action--primary"
                        disabled="@(this.busy || !this.CanSave(draft))" @onclick="this.Save">Save</button>
                <button type="button" class="action" @onclick="() => this.editorOpen = false">Cancel</button>
            </div>
        </div>
    }
</ModalView>

@code {
    const long BytesPerMb = 1024L * 1024L;

    static readonly QuotaWindow[] Windows =
        [QuotaWindow.None, QuotaWindow.Daily, QuotaWindow.Weekly, QuotaWindow.Monthly, QuotaWindow.Total];

    List<UserDetail> users = [];
    List<RoleInfo> roles = [];
    string newGroup = "";
    bool busy;
    bool passwordOk;
    PasswordPolicyInfo passwords = PasswordPolicyInfo.Off;
    bool editorOpen;
    Draft? draft;
    List<AdminAccessTokenInfo>? draftTokens;
    string? editorError;

    protected override Task OnInitializedAsync() => this.Reload();

    /// <summary>
    /// A mutable copy so a cancelled edit leaves the list untouched. The expiry is held as a date
    /// rather than an instant: an operator picks a day, and the account is good to the end of it.
    /// </summary>
    class Draft
    {
        public string? Id;
        public string Username = "";
        public string DisplayName = "";
        public string? Email;
        public string Password = "";
        public bool IsAdmin;
        public DateTime? ExpiresOn;
        public bool IsAnonymous;
        public bool IsProtected;
        public int? MaxParallelDownloads;
        public int? MaxParallelUploads;
        public QuotaWindow DownloadWindow;
        public double? DownloadMb;
        public QuotaWindow UploadWindow;
        public double? UploadMb;
        public List<string> RoleIds = [];
        public PackageAccessLevel NuGetAccess;
        public PackageAccessLevel NpmAccess;
    }

    /// <summary>Admin directly or through a group being ticked right now - the same rule the server folds.</summary>
    bool IsAdministrator(Draft draft)
        => !draft.IsAnonymous && (draft.IsAdmin || this.roles.Any(r => r.IsAdmin && draft.RoleIds.Contains(r.Id)));

    /// <summary>
    /// The option's words. "From groups" says what that currently comes to, worked out from the groups
    /// ticked in this editor, so changing a group above shows what it does to the feed below.
    /// </summary>
    string LevelText(Draft draft, PackageAccessLevel level, PackageFeedKind feed)
    {
        if (level != PackageAccessLevel.Inherit)
            return level.ToDisplay();

        var fromGroups = this.roles
            .Where(r => draft.RoleIds.Contains(r.Id))
            .Aggregate(PackagePermissions.None, (acc, r) => acc | r.Packages);

        return $"From groups ({fromGroups.LevelFor(feed).ToDisplay().ToLowerInvariant()})";
    }

    /// <summary>"NuGet: read · npm: no access", with a note when the account's own setting is doing it.</summary>
    static string PackageText(UserDetail user)
    {
        static string One(string name, PackagePermissions packages, PackageFeedKind feed, PackageAccessLevel own)
            => $"{name}: {packages.LevelFor(feed).ToDisplay().ToLowerInvariant()}{(own == PackageAccessLevel.Inherit ? "" : " (set on account)")}";

        return $"{One("NuGet", user.Packages, PackageFeedKind.NuGet, user.NuGetAccess)} · {One("npm", user.Packages, PackageFeedKind.Npm, user.NpmAccess)}";
    }

    bool CanSave(Draft draft)
    {
        if (String.IsNullOrWhiteSpace(draft.Username))
            return false;

        // An anonymous account has no password to judge, which is the whole point of it.
        if (draft.IsAnonymous)
            return true;

        return draft.Password.Length == 0 ? draft.Id is not null : this.passwordOk;
    }

    /// <summary>
    /// One tag per row, so the order is the priority. A date the account is going to stop on says
    /// more about it than the group it is in, and outranks everything but being protected.
    /// </summary>
    static string Status(UserDetail user) => user switch
    {
        // Ahead of everything else: a locked account is the one state an administrator has to act on.
        { IsLockedOut: true } => "Locked",
        { IsExpired: true } => "Expired",
        { IsProtected: true } => "Owner",
        { ExpiresAtUtc: { } expiry } => $"Expires {Day(expiry)}",
        { IsAdmin: true } => "Administrator",
        { IsAnonymous: true } => "Guest",
        _ => "Active"
    };

    /// <summary>
    /// Expiries are stored and shown as whole UTC days. Converting to local time would move a date
    /// somebody typed onto a different day for half the world, which is not what they chose.
    /// </summary>
    static string Day(DateTimeOffset value) => value.UtcDateTime.ToString("d MMM yyyy");

    static string TagClass(UserDetail user) => user switch
    {
        { IsLockedOut: true } => "tag--off",
        { IsExpired: true } => "tag--off",
        { IsProtected: true } or { IsAdmin: true } => "tag--admin",
        { ExpiresAtUtc: not null } => "tag--dated",
        _ => ""
    };

    /// <summary>"2 of 3 downloads at once" - a limit is only readable next to what is running against it.</summary>
    static string CapText(UserDetail user)
    {
        var parts = new List<string>(4);

        if (!user.Downloads.IsUncapped)
            parts.Add($"{user.Downloads.Active} of {user.Downloads.Limit} downloads at once");

        if (!user.Uploads.IsUncapped)
            parts.Add($"{user.Uploads.Active} of {user.Uploads.Limit} uploads at once");

        // The spend, not just the ceiling: a quota nobody is near and a quota about to stop somebody
        // look identical if only the limit is shown, and they are not the same row to read.
        if (!user.AccountDownload.IsUnlimited)
            parts.Add($"{Format.Bytes(user.AccountDownload.UsedBytes)} of {Format.Bytes(user.AccountDownload.LimitBytes!.Value)} down {WindowSuffix(user.AccountDownload.Window)}");

        if (!user.AccountUpload.IsUnlimited)
            parts.Add($"{Format.Bytes(user.AccountUpload.UsedBytes)} of {Format.Bytes(user.AccountUpload.LimitBytes!.Value)} up {WindowSuffix(user.AccountUpload.Window)}");

        return String.Join(" · ", parts);
    }

    static double? ToMb(long? bytes) => bytes is null ? null : Math.Round(bytes.Value / (double)BytesPerMb, 2);
    static long? ToBytes(double? mb) => mb is > 0 ? (long)(mb.Value * BytesPerMb) : null;

    static string WindowText(QuotaWindow window) => window switch
    {
        QuotaWindow.Daily => "Per day",
        QuotaWindow.Weekly => "Per week",
        QuotaWindow.Monthly => "Per month",
        QuotaWindow.Total => "Total, never resets",
        _ => "No quota"
    };

    static string WindowSuffix(QuotaWindow window) => window switch
    {
        QuotaWindow.Daily => "today",
        QuotaWindow.Weekly => "this week",
        QuotaWindow.Monthly => "this month",
        QuotaWindow.Total => "all time",
        _ => ""
    };

    /// <summary>
    /// Ticking "never expires" drops the date; unticking it proposes a month out, because an empty
    /// date input that saves as "never" would silently ignore what the operator just asked for.
    /// </summary>
    void SetNeverExpires(Draft draft, bool never)
        => draft.ExpiresOn = never ? null : DateTime.Today.AddMonths(1);

    /// <summary>
    /// The two are exclusive, and the server settles it either way - doing it here as well keeps the
    /// form from offering a password box that is about to be thrown away.
    /// </summary>
    void SetAnonymous(Draft draft, bool anonymous)
    {
        draft.IsAnonymous = anonymous;
        if (anonymous)
        {
            draft.Password = "";
            draft.IsAdmin = false;
        }
    }

    static void Toggle(List<string> list, string value, bool on)
    {
        if (on)
        {
            if (!list.Contains(value))
                list.Add(value);
        }
        else
        {
            list.Remove(value);
        }
    }

    async Task Reload()
    {
        try
        {
            this.users = await this.Admin.GetUsers();
            this.roles = await this.Admin.GetRoles();
            this.passwords = (await this.Api.GetSessionPolicy()).Passwords;
        }
        catch (ApiException ex)
        {
            await this.Toasts.DangerAsync(ex.Message);
        }
    }

    void Edit(UserDetail? user)
    {
        this.editorError = null;
        this.draft = user is null
            ? new Draft()
            : new Draft
            {
                Id = user.Id,
                Username = user.Username,
                DisplayName = user.DisplayName,
                Email = user.Email,
                IsAdmin = user.IsAdmin,
                ExpiresOn = user.ExpiresAtUtc?.UtcDateTime.Date,
                IsAnonymous = user.IsAnonymous,
                IsProtected = user.IsProtected,
                MaxParallelDownloads = user.Downloads.Limit,
                MaxParallelUploads = user.Uploads.Limit,
                DownloadWindow = user.AccountDownload.Window,
                DownloadMb = ToMb(user.AccountDownload.LimitBytes),
                UploadWindow = user.AccountUpload.Window,
                UploadMb = ToMb(user.AccountUpload.LimitBytes),
                RoleIds = [.. user.RoleIds],
                NuGetAccess = user.NuGetAccess,
                NpmAccess = user.NpmAccess
            };

        this.draftTokens = null;
        this.editorOpen = true;

        if (user is not null)
            _ = this.LoadTokens(user.Id);
    }

    async Task LoadTokens(string userId)
    {
        try
        {
            this.draftTokens = await this.Admin.GetAccessTokens(userId);
        }
        catch (ApiException ex)
        {
            this.draftTokens = [];
            await this.Toasts.DangerAsync(ex.Message);
        }

        await this.InvokeAsync(this.StateHasChanged);
    }

    async Task RevokeToken(AdminAccessTokenInfo item)
    {
        var confirmed = await this.Dialogs.Confirm(
            $"Revoke {item.Token.Name}?",
            "It stops working on the next request. Anything still configured with it is refused.",
            okText: "Revoke",
            cancelText: "Keep"
        );

        if (!confirmed)
            return;

        try
        {
            await this.Admin.RevokeAccessToken(item.Token.Id);
            await this.LoadTokens(item.UserId);
            await this.Reload();
        }
        catch (ApiException ex)
        {
            await this.Toasts.DangerAsync(ex.Message);
        }
    }

    async Task Save()
    {
        if (this.draft is not { } draft)
            return;

        this.busy = true;
        this.editorError = null;

        try
        {
            await this.Admin.SaveUser(new SaveUserRequest(
                draft.Id,
                draft.Username,
                draft.DisplayName,
                draft.Email,
                draft.Password.Length > 0 ? draft.Password : null,
                draft.IsAdmin,

                // A whole UTC day, kept as one on the way out as well as the way in. The Kind is
                // spelled out because the date arrives Utc when it was read back off an account and
                // Local when the picker has just produced it, and the offset below may only be
                // paired with the first of those - so an expiry nobody had touched saved fine while
                // one just set threw.
                draft.ExpiresOn is { } day
                    ? new DateTimeOffset(DateTime.SpecifyKind(day.Date, DateTimeKind.Utc), TimeSpan.Zero)
                    : null,

                draft.IsAnonymous,
                draft.MaxParallelDownloads,
                draft.MaxParallelUploads,
                draft.RoleIds,
                draft.DownloadWindow,
                ToBytes(draft.DownloadMb),
                draft.UploadWindow,
                ToBytes(draft.UploadMb),
                draft.NuGetAccess,
                draft.NpmAccess
            ));

            this.editorOpen = false;
            await this.Reload();
            await this.Toasts.SuccessAsync("Saved.");
        }
        catch (ApiException ex)
        {
            this.editorError = ex.Message;
        }
        finally
        {
            this.busy = false;
        }
    }

    async Task Unlock(UserDetail user)
    {
        try
        {
            await this.Admin.UnlockUser(user.Id);
            await this.Reload();
            await this.Toasts.SuccessAsync($"{user.DisplayName} can sign in again.");
        }
        catch (ApiException ex)
        {
            await this.Toasts.DangerAsync(ex.Message);
        }
    }

