@*
    The audit trail, for administrators. The filters above the grid are the questions anyone actually
    asks of a log - who, what, where and when - and they are answered by the store rather than by
    whatever rows happen to be in hand.

    The grid is Shiny's DataGrid driven by ServerData, so sorting and paging are the server's job
    too: a header that reordered sixty rows out of forty thousand would be telling the reader
    something untrue. Only the columns the store can actually order by offer to sort.
*@
@implements IDisposable
@inject FileServeApi Api
@inject AdminApi Admin
@inject IToastService Toasts

<div class="log">
    <div class="log__filters">
        <label class="log__filter">
            <span class="field__label">Who</span>
            <select @bind="this.userId" @bind:after="this.Restart">
                <option value="">Everyone</option>
                @foreach (var user in this.users)
                {
                    <option value="@user.Id">@user.DisplayName (@user.Username)</option>
                }
            </select>
        </label>

        <label class="log__filter">
            <span class="field__label">What</span>
            <select @bind="this.action" @bind:after="this.Restart">
                <option value="">Everything</option>
                @foreach (var value in Enum.GetValues<ActivityAction>())
                {
                    <option value="@((int)value)">@value.ToDisplay()</option>
                }
            </select>
        </label>

        <label class="log__filter">
            <span class="field__label">Where</span>
            <select @bind="this.folderId" @bind:after="this.Restart">
                <option value="">Every share</option>
                @foreach (var share in this.shares)
                {
                    <option value="@share.Id">@share.Name</option>
                }
            </select>
        </label>

        <label class="log__filter">
            <span class="field__label">From</span>
            <input type="date" @bind="this.from" @bind:after="this.Restart" />
        </label>

        <label class="log__filter">
            <span class="field__label">To</span>
            <input type="date" @bind="this.to" @bind:after="this.Restart" />
        </label>

        <button type="button" class="action" disabled="@(!this.HasFilters)" @onclick="this.Clear">Clear filters</button>
    </div>

    <div class="log__grid">
        @* Keyed on the filters. The grid has no public way to be told its query changed, and a
           filter change means page one anyway - so the grid is rebuilt rather than nudged. *@
        <DataGrid TItem="ActivityEntryInfo"
                  @key="this.FilterKey"
                  ServerData="this.LoadPage"
                  SortMode="DataGridSortMode.Single"
                  RowsPerPage="50"
                  FixedHeader="true"
                  Height="100%"
                  Dense="true"
                  Hover="true"
                  Striped="true"
                  NoRecordsText="Nothing matches those filters.">
            <Columns>
                <TemplateColumn TItem="ActivityEntryInfo" Title="When" Width="170px" Sortable="true">
                    <CellTemplate>
                        @* Local time to the second: a log is read by lining events up against each
                           other, and two downloads in the same minute are otherwise the same row
                           twice. The tooltip carries the UTC instant, which is what is stored. *@
                        <span class="num" title="@context.Item.TimestampUtc.UtcDateTime.ToString("u")">
                            @Stamp(context.Item.TimestampUtc)
                        </span>
                    </CellTemplate>
                </TemplateColumn>

                <PropertyColumn TItem="ActivityEntryInfo" TProperty="string"
                                Property="x => x.Username" Title="Who" Width="130px" />

                <TemplateColumn TItem="ActivityEntryInfo" Title="What" Sortable="true">
                    <CellTemplate>
                        <span class="log__what @(context.Item.Success ? "" : "log__what--failed")">
                            @context.Item.Action.ToDisplay()
                        </span>
                        @if (context.Item.Detail is { Length: > 0 } detail)
                        {
                            <span class="log__detail">@detail</span>
                        }
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn TItem="ActivityEntryInfo" Title="Where" Sortable="false">
                    <CellTemplate>
                        <span class="log__where" title="@Where(context.Item)">
                            @(Where(context.Item) is { Length: > 0 } where ? where : Nothing)
                        </span>
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn TItem="ActivityEntryInfo" Title="Address" Width="140px" Sortable="true">
                    <CellTemplate>
                        <span class="num">@(context.Item.IpAddress is { Length: > 0 } ip ? ip : Nothing)</span>
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn TItem="ActivityEntryInfo" Title="Machine" Width="170px" Sortable="false">
                    <CellTemplate>
                        <span class="num log__host" title="@context.Item.HostName">
                            @(context.Item.HostName is { Length: > 0 } host ? host : Nothing)
                        </span>
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn TItem="ActivityEntryInfo" Title="Size" Width="90px" Sortable="true">
                    <CellTemplate>
                        <span class="num log__right">@(context.Item.Bytes > 0 ? Format.Bytes(context.Item.Bytes) : "")</span>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent>
                @* The sizes the pager offers have to include the one the grid starts on, or its box shows a
                   number the grid is not using. A log is read by scanning, so they start where scanning does. *@
                <DataGridPager TItem="ActivityEntryInfo" PageSizeOptions="new[] { 25, 50, 100, 250 }" />
            </PagerContent>
        </DataGrid>
    </div>
</div>

@code {
    /// <summary>What an empty cell says. A blank one reads as a rendering fault.</summary>
    const string Nothing = "—";

    List<UserSummary> users = [];
    List<ShareInfo> shares = [];
    string userId = "";
    string action = "";
    string folderId = "";
    DateTime? from;
    DateTime? to;
    CancellationTokenSource? inflight;

    protected override async Task OnInitializedAsync()
    {
        // The two filter lists are worth one round trip each on arrival. Either failing leaves that
        // filter reading "everyone" or "every share", which is the state it starts in anyway.
        try
        {
            this.users = await this.Api.GetUsers();
        }
        catch (ApiException)
        {
        }

        try
        {
            this.shares = await this.Admin.GetShares();
        }
        catch (ApiException)
        {
        }
    }

    public void Dispose()
    {
        this.inflight?.Cancel();
        this.inflight?.Dispose();
    }

    bool HasFilters => this.userId.Length > 0
        || this.action.Length > 0
        || this.folderId.Length > 0
        || this.from is not null
        || this.to is not null;

    static string Stamp(DateTimeOffset value) => value.ToLocalTime().ToString("d MMM HH:mm:ss");

    /// <summary>
    /// The share and path the action touched. Sign-ins and refusals have neither, which is why the
    /// address is its own column rather than something this falls back to.
    /// </summary>
    static string Where(ActivityEntryInfo entry)
    {
        if (entry.FolderName is null)
            return "";

        return String.IsNullOrEmpty(entry.Path) ? entry.FolderName : $"{entry.FolderName}/{entry.Path}";
    }

    /// <summary>
    /// Changes whenever a filter does, which is what rebuilds the grid. Page seven of the old query
    /// is not page seven of the new one, so starting over is the correct answer rather than a
    /// shortcut around one.
    /// </summary>
    string FilterKey => $"{this.userId}|{this.action}|{this.folderId}|{this.from:yyyy-MM-dd}|{this.to:yyyy-MM-dd}";

    void Restart() => this.StateHasChanged();

    /// <summary>
    /// The grid asks for a page; the server answers it. Sorting arrives here as the column's own
    /// <see cref="ActivitySort"/> rather than a property name, so a column that cannot be ordered by
    /// cannot be asked for by mistake.
    /// </summary>
    async Task<GridData<ActivityEntryInfo>> LoadPage(GridState state)
    {
        // A filter changed while the last read was still out. Whichever answer came back last would
        // otherwise win, and it would not necessarily be the one that was asked for last.
        this.inflight?.Cancel();
        this.inflight?.Dispose();

        var cts = new CancellationTokenSource();
        this.inflight = cts;

        var sort = state.SortDefinitions.FirstOrDefault();

        try
        {
            var page = await this.Api.GetActivity(new ActivityQuery(
                UserId: String.IsNullOrEmpty(this.userId) ? null : this.userId,
                FolderId: String.IsNullOrEmpty(this.folderId) ? null : this.folderId,
                Action: String.IsNullOrEmpty(this.action) ? null : (ActivityAction)Int32.Parse(this.action),
                // Local calendar days off the pickers, turned into the instants the API wants -
                // see LocalDay. A "to" date means the end of that day, not its first instant, or
                // picking today for both ends returns nothing and reads as a broken filter.
                FromUtc: this.from is { } f ? LocalDay.Start(f) : null,
                ToUtc: this.to is { } t ? LocalDay.End(t) : null,

                // The grid counts pages from zero; the API from one.
                Page: state.Page + 1,
                PageSize: state.PageSize,
                SortBy: SortKey(sort),
                Descending: sort is null || sort.Direction == DataGridSortDirection.Descending
            ), cts.Token);

            return new GridData<ActivityEntryInfo>(page.Items, page.Total);
        }
        catch (OperationCanceledException)
        {
            return new GridData<ActivityEntryInfo>([], 0);
        }
        catch (ApiException ex)
        {
            await this.Toasts.DangerAsync(ex.Message);
            return new GridData<ActivityEntryInfo>([], 0);
        }
        finally
        {
            if (this.inflight == cts)
            {
                this.inflight = null;
                cts.Dispose();
            }
        }
    }

    /// <summary>
    /// Which stored column the grid's sort means. Anything unrecognised falls back to time, which is
    /// the order a log is read in and the only key nothing ties on.
    /// </summary>
    static ActivitySort SortKey(SortDefinition? sort) => sort?.ColumnId switch
    {
        // A column identifies itself by its title, and a property column by its property name.
        "Who" or nameof(ActivityEntryInfo.Username) => ActivitySort.Who,
        "What" => ActivitySort.What,
        "Address" => ActivitySort.Address,
        "Size" => ActivitySort.Size,
        _ => ActivitySort.When
    };

    async Task Clear()
    {
        this.userId = "";
        this.action = "";
        this.folderId = "";
        this.from = null;
        this.to = null;
        this.Restart();
    }
}
