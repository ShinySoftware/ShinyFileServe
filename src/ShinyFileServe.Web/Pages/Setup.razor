@page "/setup"
@inject FileServeApi Api
@inject WorkspaceState State
@inject NavigationManager Nav

<PageTitle>Set up FileServe</PageTitle>

<div class="signin">
    <aside class="signin__aside">
        <span class="chrome__mark">
            <span class="chrome__glyph" aria-hidden="true"></span>
            FileServe
        </span>

        <p class="signin__lede">Nobody has an account yet. The first one is yours.</p>

        <p class="signin__note">
            This account administers the server: every share, the activity log, and the settings.
            You can rename it and change its password later, but it cannot be deleted — a server
            with no way back into its own settings is a server nobody can fix.
        </p>
    </aside>

    <div class="signin__form">
        @if (!this.canSetUpHere)
        {
            @* Refused before the form rather than after it: showing fields the server is going to
               reject would waste somebody's password on a 403. *@
            <div class="signin__card">
                <h1>Set this up on the server itself</h1>
                <p style="color:var(--ink-2); margin-top:4px;">
                    The first account can only be created from the machine running FileServe, so that
                    whoever finds this address on the network cannot claim it.
                </p>
                <p style="color:var(--ink-2);">
                    Open FileServe on that machine — its window is this same page — and create the
                    administrator there. Then sign in from here.
                </p>
            </div>
        }
        else
        {
        <form class="signin__card" @onsubmit="this.Submit" @onsubmit:preventDefault>
            <div>
                <h1>Create the administrator</h1>
                <p style="color:var(--ink-2); margin-top:4px;">You will be signed in straight away.</p>
            </div>

            @if (this.error is { Length: > 0 })
            {
                <p class="form-error" role="alert">@this.error</p>
            }

            <label class="field">
                <span class="field__label">Your name</span>
                <input type="text" autocomplete="name" autofocus @bind="this.displayName" @bind:event="oninput" />
            </label>

            <label class="field">
                <span class="field__label">Username</span>
                <input type="text" autocomplete="username" @bind="this.username" @bind:event="oninput" />
            </label>

            <PasswordField Label="Password"
                           Policy="this.policy.Passwords"
                           Password="@this.password"
                           PasswordChanged="v => this.password = v"
                           AcceptableChanged="v => this.passwordOk = v"
                           UserInputs="this.Identifiers"
                           Hint="There is no reset link — write it down." />

            <label class="field">
                <span class="field__label">Password again</span>
                <input type="password" autocomplete="new-password" @bind="this.confirm" @bind:event="oninput" />
            </label>

            <button type="submit" class="action action--primary" style="justify-content:center; padding:9px;"
                    disabled="@(this.busy || !this.CanSubmit)">
                @(this.busy ? "Creating…" : "Create account")
            </button>
        </form>

        @* Moving or rebuilding a server should bring its accounts with it, not start them over. *@
        <div class="signin__card signin__restore">
            <div>
                <h2>Or restore a backup</h2>
                <p style="color:var(--ink-2); margin-top:4px;">
                    Bring back the accounts, shares and settings from a FileServe backup instead of
                    starting fresh. The files themselves are not in it — point the shares back at them.
                </p>
            </div>

            @if (this.restoreError is { Length: > 0 })
            {
                <p class="form-error" role="alert">@this.restoreError</p>
            }

            @if (this.staged is { IsValid: true } staged)
            {
                <div class="restore">
                    <p class="restore__title">Ready to restore</p>
                    <p class="restore__body">
                        @staged.Users @(staged.Users == 1 ? "account" : "accounts")
                        (@staged.Administrators @(staged.Administrators == 1 ? "administrator" : "administrators")),
                        @staged.Shares @(staged.Shares == 1 ? "share" : "shares"),
                        @staged.ActivityEntries log @(staged.ActivityEntries == 1 ? "entry" : "entries")
                        · @Format.Bytes(staged.SizeBytes)
                        @if (staged.TakenUtc is { } taken)
                        {
                            <span> · settings last changed @Format.When(taken)</span>
                        }
                    </p>
                    <div class="admin__actions">
                        <button type="button" class="action action--primary" disabled="@this.busy"
                                @onclick="this.Restore">@(this.restoring ? "Restoring…" : "Restore and restart")</button>
                        <button type="button" class="action" disabled="@this.busy"
                                @onclick="this.DiscardBackup">Cancel</button>
                    </div>
                </div>
            }
            else
            {
                @if (this.staged is { IsValid: false, Problem: { Length: > 0 } problem })
                {
                    <p class="form-error" role="alert">@problem</p>
                }

                <label class="action" style="justify-content:center; padding:9px;">
                    @(this.busy ? "Reading…" : "Choose a backup…")
                    <InputFile OnChange="this.OnBackupPicked" accept=".db" style="display:none" disabled="@this.busy" />
                </label>
            }
        </div>
        }
    </div>
</div>

@code {
    string displayName = "";
    string username = "";
    string password = "";
    string confirm = "";
    bool busy;
    bool passwordOk;
    bool canSetUpHere = true;
    bool restoring;
    string? error;
    string? restoreError;
    BackupSummary? staged;
    SessionPolicy policy = new(true, true, true, 30, 0, PasswordPolicyInfo.Off, []);

    bool CanSubmit => !String.IsNullOrWhiteSpace(this.username) && this.passwordOk;

    /// <summary>Fed to the meter so it can refuse a password that is just the person's own name.</summary>
    IReadOnlyList<string> Identifiers => [this.username, this.displayName];

    protected override async Task OnInitializedAsync()
    {
        // Someone else may have set the server up between the page loading and this running.
        try
        {
            this.policy = await this.Api.GetSessionPolicy();
            this.canSetUpHere = this.policy.CanCompleteSetup;

            if (!this.policy.NeedsSetup)
                this.Nav.NavigateTo("signin");
        }
        catch (ApiException)
        {
            // The server will refuse the submit too, with a message worth showing.
        }
    }

    async Task OnBackupPicked(InputFileChangeEventArgs args)
    {
        if (args.FileCount == 0 || this.busy)
            return;

        this.busy = true;
        this.staged = null;
        this.restoreError = null;

        try
        {
            // Same cap as the administrator's restore: a guard against picking a disk image by mistake.
            await using var content = args.File.OpenReadStream(512L * 1024 * 1024);
            this.staged = await this.Api.StageSetupRestore(args.File.Name, content, args.File.Size);
        }
        catch (Exception ex) when (ex is ApiException or IOException)
        {
            this.restoreError = ex.Message;
        }
        finally
        {
            this.busy = false;
        }
    }

    async Task DiscardBackup()
    {
        this.busy = true;

        try
        {
            await this.Api.DiscardSetupRestore();
            this.staged = null;
        }
        catch (ApiException ex)
        {
            this.restoreError = ex.Message;
        }
        finally
        {
            this.busy = false;
        }
    }

    async Task Restore()
    {
        this.busy = true;
        this.restoring = true;
        this.restoreError = null;

        try
        {
            await this.Api.RestoreAtSetup();
        }
        catch (ApiException ex)
        {
            this.restoreError = ex.Message;
            this.busy = false;
            this.restoring = false;
            return;
        }

        // The listener goes away for the swap. Once it answers again the restored accounts exist,
        // and this machine's own window signs straight in as their administrator.
        for (var attempt = 0; attempt < 40; attempt++)
        {
            await Task.Delay(500);

            try
            {
                var policy = await this.Api.GetSessionPolicy();
                if (!policy.NeedsSetup)
                {
                    this.Nav.NavigateTo(this.Nav.BaseUri, forceLoad: true);
                    return;
                }
            }
            catch (Exception)
            {
                // Still down. The restart is a second or two; keep asking.
            }
        }

        this.restoreError = "The server has not come back. Close FileServe and open it again.";
        this.busy = false;
        this.restoring = false;
    }

    async Task Submit()
    {
        if (this.busy || !this.CanSubmit)
            return;

        if (this.password != this.confirm)
        {
            this.error = "Those two passwords do not match.";
            return;
        }

        this.busy = true;
        this.error = null;

        try
        {
            var user = await this.Api.CompleteSetup(this.username.Trim(), this.password, this.displayName.Trim());
            this.State.SetUser(user);
            this.Nav.NavigateTo("");
        }
        catch (ApiException ex)
        {
            this.error = ex.Message;
        }
        finally
        {
            this.busy = false;
        }
    }
}
