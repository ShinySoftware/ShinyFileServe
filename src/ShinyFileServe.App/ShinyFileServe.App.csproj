<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      One net10.0 target serves all three heads. The macOS (net10.0-macos) and Windows
      (net10.0-windows...) heads reference this happily, and the Linux GTK4 head is itself plain
      net10.0 - which is the only reason the shared UI cannot multi-target platform TFMs.

      No UseMaui: on a plain net10.0 project it only asks the SDK for a MAUI workload, and on Linux
      the one it finds is Tizen. The Microsoft.Maui.Controls package compiles the XAML on its own.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ShinyFileServe.App</RootNamespace>
    <EnableDefaultMauiItems>true</EnableDefaultMauiItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Shiny.Maui.Controls.Desktop" />
    <PackageReference Include="Shiny.Notifications" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <!-- Release notes from GitHub, rendered for the update screen. -->
    <PackageReference Include="Markdig" />
  </ItemGroup>

  <ItemGroup>
    <!-- Read straight out of the assembly: the three heads lay out their app bundles differently
         and a missing package file would mean no tray icon at all. -->
    <EmbeddedResource Include="Resources\trayicon.png" />
    <EmbeddedResource Include="Resources\trayicon-active.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShinyFileServe.Server\ShinyFileServe.Server.csproj" />
    <ProjectReference Include="..\ShinyFileServe.Core\ShinyFileServe.Core.csproj" />
    <ProjectReference Include="..\ShinyFileServe.Shared\ShinyFileServe.Shared.csproj" />
  </ItemGroup>
</Project>
