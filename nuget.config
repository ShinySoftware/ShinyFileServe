<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Shiny.Net.HttpServer 2.1 pre-release, packed locally (dotnet pack -o artifacts/local-feed in the
         httpserver repo). Remove once 2.1 is published to nuget.org. -->
    <add key="httpserver-local" value="../httpserver/artifacts/local-feed" />
  </packageSources>
</configuration>
