<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- A true AppKit app (NSWindow, NSStatusItem, native menu bar) via dotnet/maui-labs.
         This is NOT Mac Catalyst. -->
    <TargetFramework>net10.0-macos</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <SupportedOSPlatformVersion>14.0</SupportedOSPlatformVersion>
    <RootNamespace>ShinyFileServe.MacOS</RootNamespace>

    <ApplicationTitle>FileServe</ApplicationTitle>
    <ApplicationId>net.shinylib.fileserve</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Apple silicon only. Left unset, a Release build compiles both architectures and lipos them
         into one universal bundle - every assembly AOT'd twice for an Intel build nobody runs. Here
         rather than on the command line so every publish agrees. The bundle to ship is then
         bin/Release/net10.0-macos/osx-arm64/FileServe.app; publish without -o, which splits it. -->
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.Maui.Platforms.MacOS" />
    <PackageReference Include="Microsoft.Maui.Platforms.MacOS.Essentials" />
    <PackageReference Include="Shiny.Maui.Controls.Desktop" />
    <PackageReference Include="Shiny.Notifications" />
  </ItemGroup>

  <ItemGroup>
    <!-- The backend turns this into the platform's own icon container. -->
    <MauiIcon Include="..\..\src\ShinyFileServe.App\Resources\AppIcon\appicon.svg" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ShinyFileServe.App\ShinyFileServe.App.csproj" />
  </ItemGroup>
</Project>
