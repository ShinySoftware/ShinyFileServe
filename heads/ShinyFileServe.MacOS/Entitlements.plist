<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		Notarization requires the hardened runtime, which blocks these unless they are declared.
		Only the JIT is needed: the app is not sandboxed, so listening on the network needs no
		entitlement, and local network access is asked for through NSLocalNetworkUsageDescription.
	-->
	<!-- CoreCLR's JIT. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
