<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="Shiny.Core" Version="7.2.0"/>
        <PackageVersion Include="Shiny.Net.HttpServer" Version="3.2.0"/>
        <PackageVersion Include="Shiny.Net.HttpServer.NuGet" Version="3.2.0"/>
        <PackageVersion Include="Shiny.Net.HttpServer.Npm" Version="3.2.0"/>
        <PackageVersion Include="Shiny.Net.HttpServer.Tus" Version="3.2.0"/>
        <PackageVersion Include="Shiny.AppDeviceBridge" Version="4.2.0"/>
        <PackageVersion Include="Shiny.AppDeviceBridge.WebView" Version="4.2.0"/>
        <PackageVersion Include="Shiny.AppDeviceBridge.Tunnel" Version="4.2.0"/>
        <PackageVersion Include="Shiny.DocumentDb" Version="15.0.0"/>
        <PackageVersion Include="Shiny.DocumentDb.Sqlite" Version="15.0.0"/>
        
        <PackageVersion Include="Shiny.Blazor.Controls" Version="3.0.0"/>
        <PackageVersion Include="Shiny.Maui.Controls" Version="3.0.0"/>
        <PackageVersion Include="Shiny.Maui.Controls.Desktop" Version="3.0.0"/>
        <PackageVersion Include="Shiny.Notifications" Version="7.2.0"/>
        <PackageVersion Include="Shiny.Notifications.Linux" Version="7.2.0"/>
        
        <PackageVersion Include="nClam" Version="9.0.0"/>
        <PackageVersion Include="Markdig" Version="1.6.0"/>
        
        <PackageVersion Include="Microsoft.Data.Sqlite" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.Maui.Controls" Version="$(MauiVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="11.0.0"/>

        <PackageVersion Include="xunit.v3" Version="4.0.3"/>
        <PackageVersion Include="Microsoft.Extensions.Logging" Version="11.0.0"/>

        <PackageVersion Include="Microsoft.Maui.Platforms.MacOS" Version="0.1.0-preview.16.26575.3"/>
        <PackageVersion Include="Microsoft.Maui.Platforms.MacOS.Essentials" Version="0.1.0-preview.16.26575.3"/>
        <PackageVersion Include="Microsoft.Maui.Platforms.Linux.Gtk4" Version="0.1.0-preview.16.26575.3"/>
        <PackageVersion Include="Microsoft.Maui.Platforms.Linux.Gtk4.Essentials" Version="0.1.0-preview.16.26575.3"/>
    </ItemGroup>
</Project>
